# Copy to .env and fill in. Never commit the real .env.

# ── Required ─────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True

# ── Production ───────────────────────────────────────────────────────────────
# SITE_DOMAIN=siphira.fluximpact.org
# ALLOWED_HOSTS=siphira.fluximpact.org,127.0.0.1,localhost

# Salt for the daily-rotating visitor hash. Changing it resets visitor identity
# (views are still counted; repeat-visit detection just restarts). Must be set
# in production — the default is public in this file.
# ANALYTICS_SALT=some-long-random-string

# ── Admin bootstrap (used by `manage.py create_admin`) ───────────────────────
# ADMIN_USERNAME=siphira
# ADMIN_EMAIL=siphirawanjiku0@gmail.com
# ADMIN_PASSWORD=
# Set ADMIN_PASSWORD_RESET=1 to force-reset an existing user's password.

# ── Notifications ────────────────────────────────────────────────────────────
# The droplet blocks outbound SMTP, so new messages/comments are pushed via
# ntfy.sh instead of email. Pick a long, secret topic and subscribe to it in
# the ntfy app. Leave blank to disable notifications entirely.
# NTFY_TOPIC=siphira-changeme-secret
